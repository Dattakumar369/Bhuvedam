{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bhuvedam.vercel.app",
        "EXPO_PUBLIC_USE_BACKEND_DATA": "true",
        "EXPO_PUBLIC_USE_BACKEND_AI": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-RENDER-APP.onrender.com",
        "EXPO_PUBLIC_USE_BACKEND_DATA": "true",
        "EXPO_PUBLIC_USE_BACKEND_AI": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-RENDER-APP.onrender.com",
        "EXPO_PUBLIC_USE_BACKEND_DATA": "true",
        "EXPO_PUBLIC_USE_BACKEND_AI": "true",
        "EXPO_PUBLIC_AI_PROVIDER": "ollama"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
