# Bhuvedam mobile app — environment variables
# Copy to .env and fill in values. NEVER commit .env with real secrets.

# --- Backend API (required for production) ---
# Local dev: your PC LAN IP, e.g. http://192.168.1.13:3001
# Production: Render/Railway URL, e.g. https://bhuvedam-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:3001

# Sync farmer profile, mandi, ag catalog from Neon via backend
EXPO_PUBLIC_USE_BACKEND_DATA=true

# Route AI chat through backend (keeps Ollama key off the client — recommended for Play Store)
EXPO_PUBLIC_USE_BACKEND_AI=true

# Weather: set to "true" only if you deploy a NestJS weather backend
EXPO_PUBLIC_USE_BACKEND_WEATHER=false

# AI provider on client (only used when EXPO_PUBLIC_USE_BACKEND_AI=false)
EXPO_PUBLIC_AI_PROVIDER=ollama

# DO NOT put production API keys here for Play Store builds.
# Set OLLAMA_API_KEY on the backend instead (see backend/.env.example).
# EXPO_PUBLIC_OLLAMA_API_KEY=
# EXPO_PUBLIC_OLLAMA_API_URL=https://ollama.com
# EXPO_PUBLIC_OLLAMA_MODEL=llama3.2

# Mandi rates — optional if EXPO_PUBLIC_USE_BACKEND_DATA=true
EXPO_PUBLIC_DATA_GOV_API_KEY=

# --- Production checklist ---
# 1. Deploy backend (backend/render.yaml) and set DATABASE_URL, JWT_SECRET, ADMIN_API_KEY
# 2. Run: cd backend && npm run db:push
# 3. Replace EXPO_PUBLIC_API_URL with public HTTPS URL
# 4. Set EXPO_PUBLIC_USE_BACKEND_AI=true (remove client Ollama key)
# 5. Run: eas init  →  update app.json extra.eas.projectId
# 6. eas build --platform android --profile production
# 7. Android push (FCM): Firebase project for com.bhuvedam.app → eas credentials → Android → production → FCM V1
# 8. Host privacy policy at public HTTPS URL for Play Console
# 8. 2Factor OTP key → backend/.env TWOFACTOR_API_KEY (OTP_DEV_MODE=false in prod)
# 9. OTA updates: npm run update:production (uses EAS production env, not local .env)
