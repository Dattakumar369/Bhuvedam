{
  "name": "bhuvedam-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.cts",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "build:vercel": "esbuild src/index.cts --bundle --platform=node --format=cjs --outfile=api/index.cjs --packages=external",
    "start": "node dist/index.js",
    "sync": "tsx src/ingestion/syncAll.ts",
    "sync:complete": "tsx src/ingestion/syncAll.ts complete",
    "sync:crops": "tsx src/ingestion/syncAll.ts crops",
    "sync:crops:full": "tsx src/ingestion/syncAll.ts crops && npm run db:seed:crops",
    "sync:mandi": "tsx src/ingestion/syncAll.ts mandi",
    "sync:soil": "tsx src/ingestion/syncAll.ts soil",
    "sync:weather": "tsx src/ingestion/syncAll.ts weather",
    "sync:fertilizers": "tsx src/ingestion/syncAll.ts fertilizers",
    "sync:fertilizer-catalog": "tsx src/ingestion/syncAll.ts fertilizer-catalog",
    "sync:ag-catalog": "tsx src/ingestion/syncAll.ts ag-catalog",
    "sync:bulk-catalog": "tsx src/ingestion/syncAll.ts bulk-catalog",
    "sync:knowledge": "tsx src/ingestion/syncAll.ts knowledge",
    "sync:publications": "tsx src/ingestion/syncAll.ts publications",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:migrate:auth": "tsx scripts/migrate-auth-columns.ts",
    "db:seed:crops": "tsx src/ingestion/seedBhuvedamCrops.ts",
    "export:crops": "cd .. && npx tsx --tsconfig tsconfig.json scripts/export-crops-catalog.ts",
    "count:crops": "tsx scripts/count-crops.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@hono/node-server": "^1.19.0",
    "@neondatabase/serverless": "^1.0.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.2",
    "esbuild": "^0.25.9",
    "expo-server-sdk": "^3.15.0",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
