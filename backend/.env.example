# Neon PostgreSQL — pooled connection string from console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# API server port (Render sets PORT automatically)
PORT=3001

# Log level: debug | info | warn | error
LOG_LEVEL=debug

# Required in production — signs farmer JWT tokens (min 32 chars)
JWT_SECRET=change-this-to-a-long-random-secret

# Protects admin/sync cron routes — pass as X-Admin-Key header
ADMIN_API_KEY=change-this-admin-key

# Protect daily push cron (cron-job.org free tier)
CRON_SECRET=your-random-secret-here

# Agmarknet sync (data.gov.in free API key)
DATA_GOV_API_KEY=

# --- OTP login ---
# voice = phone call OTP (no DLT needed) — default until SMS template is approved
# sms   = DLT transactional SMS (set after TWOFACTOR template + sender are live)
OTP_CHANNEL=voice
# Dev mode: logs OTP to console instead of 2Factor (local only)
OTP_DEV_MODE=true
OTP_PEPPER=change-this-secret

# Production SMS via 2Factor.in (https://2factor.in)
# When DLT is approved, set OTP_CHANNEL=sms and OTP_DEV_MODE=false
TWOFACTOR_OTP_TEMPLATE=BhuvedamLoginOTP
TWOFACTOR_SENDER_ID=BHUVED
# TSMS = real text SMS (Transactional SMS balance). Voice uses VOICE/AUTOGEN.
TWOFACTOR_API_KEY=your-2factor-api-key

# --- AI proxy (keys stay on server, not in mobile app) ---
# Provider: gemini (recommended) | ollama
AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Serper for richer web search (https://serper.dev)
SERPER_API_KEY=

# Ollama (fallback if Gemini fails)
OLLAMA_API_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_VISION_MODEL=llama3.2-vision

# --- Production checklist ---
# 1. OTP_DEV_MODE=false when TWOFACTOR_API_KEY is set
# 2. JWT_SECRET and ADMIN_API_KEY must be strong random values
# 3. npm run db:push  (farmers, otp_codes, push_tokens tables)
# 4. Deploy: Railway/Render (npm start) or Vercel (src/server.ts, set env vars in dashboard)
#
# --- Vercel ---
# Import repo with Root Directory = backend
# Add all variables above in Project → Settings → Environment Variables
# CRON_SECRET is sent as Authorization: Bearer <secret> by Vercel Cron
