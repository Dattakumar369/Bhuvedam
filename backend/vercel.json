{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "functions": {
    "src/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notifications/cron/daily",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/daily-data",
      "schedule": "0 2 * * *"
    }
  ]
}
