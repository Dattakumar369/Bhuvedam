{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notifications/cron/daily",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/daily-data",
      "schedule": "0 2 * * *"
    }
  ]
}
